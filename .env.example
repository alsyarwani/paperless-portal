# salin jadi .env lalu isi
PORTAL_USER=admin
PORTAL_PASSWORD=ganti-dengan-password-kuat
# buat dengan: openssl rand -hex 32   (JANGAN diganti setelah instance disimpan; token terenkripsi pakai ini)
SECRET_KEY=
# true kalau diakses lewat https (reverse proxy aaPanel)
COOKIE_SECURE=false
# IP untuk publish port: 127.0.0.1, IP tailnet host (100.x.x.x), atau 0.0.0.0
PORTAL_BIND=127.0.0.1
PORTAL_PORT=8650
